int '_ = 1; // @error
type _ int; // @error
type Broken mod:_; // @error
type Nested map<mod:_>[]; // @error
function types() {
    int '_ = 1; // @error
    int = 2; // @error
    mod:_ local = 3; // @error
    int later = 4; // @error unused surviving sibling
}
function valid() {}
function discarded(int _) {} // @error discarded signature
function discardedReferences() {
    discarded();
    int surviving = 5; // @error unused surviving sibling
}
-- ast --
(package
  (variable (bad-identifier) (type
    (value-type int)) (expr
    (literal 1)))
  (type-definition (bad-identifier)
    (value-type int))
  (type-definition Broken
    (bad-type qualified-reference (tokens (":" 19:16 19:17))))
  (type-definition Nested
    (array-type
      (constrained-type
        (builtin-ref-type map)
        (bad-type qualified-reference (tokens (":" 20:20 20:21)))) dimensions: 1 ([])))
  (function types () (
    (value-type null))
    (block-function-body
      (var-def
        (variable (bad-identifier) (type
          (value-type int)) (expr
          (literal 1))))
      (var-def
        (variable (bad-identifier) (type
          (value-type int)) (expr
          (literal 2))))
      (var-def
        (variable local (type
          (bad-type qualified-reference (tokens (":" 24:8 24:9)))) (expr
          (literal 3))))
      (var-def
        (variable later (type
          (value-type int)) (expr
          (literal 4))))))
  (function valid () (
    (value-type null))
    (block-function-body))
  (function discarded (
    (variable (bad-identifier) (type
      (value-type int)))) (
    (value-type null))
    (block-function-body))
  (function discardedReferences () (
    (value-type null))
    (block-function-body
      (expression-stmt
        (invocation discarded ()))
      (var-def
        (variable surviving (type
          (value-type int)) (expr
          (literal 5)))))))
