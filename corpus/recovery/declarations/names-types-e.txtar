int '_ = 1; // @error
type _ int; // @error
type Broken mod:_; // @error
type Nested map<mod:_>[]; // @error
function types() {
    int '_ = 1; // @error
    int = 2; // @error
    mod:_ local = 3; // @error
    int later = 4; // @error unused surviving sibling
}
function valid() {}
function discarded(int _) {} // @error discarded signature
function discardedReferences() {
    discarded(); // @error unresolved discarded declaration
    int surviving = 5; // @error unused surviving sibling
}
-- ast --
(package
  (type-definition Broken
    (bad-type))
  (type-definition Nested
    (bad-type))
  (function types () (
    (value-type null))
    (block-function-body
      (bad-stmt)
      (bad-stmt)
      (var-def
        (variable local (type
          (bad-type)) (expr
          (literal 3))))
      (var-def
        (variable later (type
          (value-type int)) (expr
          (literal 4))))))
  (function valid () (
    (value-type null))
    (block-function-body))
  (function discardedReferences () (
    (value-type null))
    (block-function-body
      (expression-stmt
        (invocation discarded ()))
      (var-def
        (variable surviving (type
          (value-type int)) (expr
          (literal 5))))))
  (bad-top-level variable)
  (bad-top-level type-definition)
  (bad-top-level function))
