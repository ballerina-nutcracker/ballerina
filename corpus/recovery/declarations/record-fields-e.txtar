type OpenMissingType record {
    a; // @error
    int valid;
};
type OpenMissingTypeWithDefault record {
    a = 1; // @error
    int valid;
};
type OpenMissingName record {
    int; // @error
    int valid;
};
type OpenMissingNameWithDefault record {
    int = 1; // @error
    int valid;
};
type OpenMissingDefault record {
    int a = ; // @error
    int valid;
};
type ClosedMissingType record {|
    a; // @error
    int valid;
|};
type ClosedMissingTypeWithDefault record {|
    a = 1; // @error
    int valid;
|};
type ClosedMissingName record {|
    int; // @error
    int valid;
|};
type ClosedMissingNameWithDefault record {|
    int = 1; // @error
    int valid;
|};
type ClosedMissingDefault record {|
    int a = ; // @error
    int valid;
|};
type OpenMissingSemicolon record {
    int a = 1
    int valid; // @error missing semicolon is reported at the next field
};
type ClosedMissingSemicolon record {|
    int a = 1
    int valid; // @error missing semicolon is reported at the next field
|};
type OpenInclusionMissingSemicolon record {
    *MissingRecordBase
    int valid; // @error missing semicolon is reported at the next field
};
type ClosedInclusionMissingSemicolon record {|
    *MissingRecordBase
    int valid; // @error missing semicolon is reported at the next field
|};
type MissingInclusionType record {
    *; // @error
    int valid;
};
type Valid record {| int a; |};
-- ast --
(package
  (type-definition OpenMissingType
    (bad-type record (tokens ("record" 17:22 17:28) ("{" 17:29 17:30) (";" 18:6 18:7) ("int" 19:5 19:8) (";" 19:14 19:15) ("}" 20:1 20:2))))
  (type-definition OpenMissingTypeWithDefault
    (bad-type record (tokens ("record" 21:33 21:39) ("{" 21:40 21:41) ("=" 22:7 22:8) (";" 22:10 22:11) ("int" 23:5 23:8) (";" 23:14 23:15) ("}" 24:1 24:2))))
  (type-definition OpenMissingName
    (bad-type record (tokens ("record" 25:22 25:28) ("{" 25:29 25:30) ("int" 26:5 26:8) (";" 26:8 26:9) ("int" 27:5 27:8) (";" 27:14 27:15) ("}" 28:1 28:2))))
  (type-definition OpenMissingNameWithDefault
    (bad-type record (tokens ("record" 29:33 29:39) ("{" 29:40 29:41) ("int" 30:5 30:8) ("=" 30:9 30:10) (";" 30:12 30:13) ("int" 31:5 31:8) (";" 31:14 31:15) ("}" 32:1 32:2))))
  (type-definition OpenMissingDefault
    (record-type
      (field a
        (value-type int)
        (simple-var-ref (bad-identifier)))
      (field valid
        (value-type int))))
  (type-definition ClosedMissingType
    (bad-type record (tokens ("record" 37:24 37:30) ("{|" 37:31 37:33) (";" 38:6 38:7) ("int" 39:5 39:8) (";" 39:14 39:15) ("|}" 40:1 40:3))))
