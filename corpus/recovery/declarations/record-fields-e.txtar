  (type-definition ClosedMissingDefault
    (record-type
      (field a
        (value-type int)
        (simple-var-ref (bad-identifier)))
      (field valid
        (value-type int))))
  (type-definition OpenMissingSemicolon
    (bad-type record (tokens ("record" 57:27 57:33) ("{" 57:34 57:35) ("int" 58:5 58:8) ("=" 58:11 58:12) ("int" 59:5 59:8) (";" 59:14 59:15) ("}" 60:1 60:2))))
  (type-definition ClosedMissingSemicolon
    (bad-type record (tokens ("record" 61:29 61:35) ("{|" 61:36 61:38) ("int" 62:5 62:8) ("=" 62:11 62:12) ("int" 63:5 63:8) (";" 63:14 63:15) ("|}" 64:1 64:3))))
