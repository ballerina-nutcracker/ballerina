public enum Colour { R, G = } // @error
function useColour() returns Colour { return R; }
-- ast --
(package
  (const R enum-member (
    (value-type string)) (
    (literal R)))
  (type-definition Colour enum
    (user-defined-type R))
  (function useColour () (
    (user-defined-type Colour))
    (block-function-body
      (return
        (simple-var-ref R))))
  (bad-top-level enum))
-- symbols --
+Colour +R -G +useColour
