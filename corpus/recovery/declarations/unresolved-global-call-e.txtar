Unknown abandoned = ordinary(); // @error
int unresolved = missing(); // @error

function independent() returns int {
    int invalid = "wrong"; // @error
    return 1;
}
-- ast --
(package
  (variable abandoned (type
    (user-defined-type Unknown)) (expr
    (invocation ordinary ())))
  (variable unresolved (type
    (value-type int)) (expr
    (invocation missing ())))
  (function independent () (
    (value-type int))
    (block-function-body
      (var-def
        (variable invalid (type
          (value-type int)) (expr
          (literal wrong))))
      (return
        (literal 1)))))
