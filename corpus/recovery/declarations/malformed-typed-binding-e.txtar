int[] '_ = [0]; // @error malformed module variable name

function surviving() returns int {
    int[] '_ = [0]; // @error malformed local variable name
    return 7;
}

public int sibling = surviving();
-- ast --
(package
  (variable sibling (type
    (value-type int)) (expr
    (invocation surviving ())))
  (function surviving () (
    (value-type int))
    (block-function-body
      (bad-stmt)
      (return
        (literal 7))))
  (bad-top-level variable))
