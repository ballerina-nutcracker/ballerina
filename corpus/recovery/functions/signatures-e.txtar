function _() {} // @error
function (int x) {} // @error
function ordinary(int _) {} // @error
function missing(int ) {} // @error
function rest(int... _) {} // @error
function defaults(int x = ) {} // @error
function returnsBad() returns mod:_ {} // @error
@mod:_ function annotated() {} // @error
public public function qualifiers() {} // @error
function valid() returns int => 1;
function discardedReferences() returns int {
    int ordinaryResult = ordinary(1); // @error discarded declaration reference
    int defaultResult = defaults(); // @error discarded declaration reference
    int later = valid();
    return later;
}
-- ast --
(package
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1)))
  (function discardedReferences () (
    (value-type int))
    (block-function-body
      (var-def
        (variable ordinaryResult (type
          (value-type int)) (expr
          (invocation ordinary (
            (literal 1))))))
      (var-def
        (variable defaultResult (type
          (value-type int)) (expr
          (invocation defaults ()))))
      (var-def
        (variable later (type
          (value-type int)) (expr
          (invocation valid ()))))
      (return
        (simple-var-ref later))))
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function)
  (bad-top-level function))
