function method() returns int; // @error missing body
function method() returns int; // @error duplicate declaration and missing body
function surviving(int value) returns int => value;
-- ast --
(package
  (function method () (
    (value-type int))
    (extern-function-body))
  (function method () (
    (value-type int))
    (extern-function-body))
  (function surviving (
    (variable value (type
      (value-type int)))) (
    (value-type int))
    (expr-function-body
      (simple-var-ref value))))
