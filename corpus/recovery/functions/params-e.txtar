function missingComma(int a int b) {} // @error
function missingFirstType(a, int b) {} // @error
function missingSecondType(int a, b) {} // @error
function leadingComma(, int a) {} // @error
function trailingComma(int a, ) {} // @error
function mixed(int a, string b = , int c = 1, d, int... ) {} // @error
function valid(int a, int b = 1, int... rest) returns int => a + b + rest.length();
-- ast --
(package
  (function missingFirstType (
    (variable (bad-identifier) (type
      (user-defined-type a)))
    (variable b (type
      (value-type int)))) (
    (value-type null))
    (block-function-body))
  (function missingSecondType (
    (variable a (type
      (value-type int)))
    (variable (bad-identifier) (type
      (user-defined-type b)))) (
    (value-type null))
    (block-function-body))
  (function leadingComma (
    (variable a (type
      (bad-type builtin (tokens ("int" 20:25 20:28)))))) (
    (value-type null))
    (block-function-body))
  (function trailingComma (
    (variable a (type
      (value-type int)))
    (variable (bad-identifier) (type
      (bad-type simple-reference)))) (
    (value-type null))
    (block-function-body))
  (function valid (
    (variable a (type
      (value-type int)))
    (variable b (type
      (value-type int)) (expr
      (literal 1)))) (
    (value-type int))
    (expr-function-body
      (binary-expr +
        (binary-expr +
          (simple-var-ref a)
          (simple-var-ref b))
        (invocation length expr:
          (simple-var-ref rest) ()))))
  (bad-top-level function (tokens ("function" 17:1 17:9) ("(" 17:22 17:23) ("int" 17:23 17:26) ("int" 17:29 17:32) (")" 17:34 17:35) ("{" 17:36 17:37) ("}" 17:37 17:38)))
  (bad-top-level function (tokens ("function" 22:1 22:9) ("(" 22:15 22:16) ("int" 22:16 22:19) ("," 22:21 22:22) ("string" 22:23 22:29) ("=" 22:32 22:33) ("," 22:34 22:35) ("int" 22:36 22:39) ("=" 22:42 22:43) ("," 22:45 22:46) (")" 22:57 22:58) ("{" 22:59 22:60) ("}" 22:60 22:61))))
