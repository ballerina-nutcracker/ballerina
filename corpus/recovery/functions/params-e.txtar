function missingComma(int a int b) {} // @error
function missingFirstType(a, int b) {} // @error
function missingSecondType(int a, b) {} // @error
function leadingComma(, int a) {} // @error
function trailingComma(int a, ) {} // @error
function mixed(int a, string b = , int c = 1, d, int... ) {} // @error
function valid(int a, int b = 1, int... rest) returns int => a + b + rest.length();
-- ast --
(package
  (function missingFirstType (
    (variable (bad-identifier) (type
      (user-defined-type a)))
    (variable b (type
      (value-type int)))) (
    (value-type null))
    (block-function-body))
  (function missingSecondType (
    (variable a (type
      (value-type int)))
    (variable (bad-identifier) (type
      (user-defined-type b)))) (
    (value-type null))
    (block-function-body))
  (function leadingComma (
    (variable a (type
      (bad-type)))) (
    (value-type null))
    (block-function-body))
  (function trailingComma (
    (variable a (type
      (value-type int)))
    (variable (bad-identifier) (type
      (bad-type)))) (
    (value-type null))
    (block-function-body))
  (function valid (
    (variable a (type
      (value-type int)))
    (variable b (type
      (value-type int)) (expr
      (literal 1)))) (
    (value-type int))
    (expr-function-body
      (binary-expr +
        (binary-expr +
          (simple-var-ref a)
          (simple-var-ref b))
        (invocation length expr:
          (simple-var-ref rest) ()))))
  (bad-top-level function)
  (bad-top-level function))
