function blockMissingType() returns {} // @error
function exprMissingType() returns => 1; // @error
function blockMissingKeyword() int {} // @error
function exprMissingKeyword() int => 1; // @error
function valid() returns int => 1;
-- ast --
(package
  (function blockMissingType () (
    (bad-type))
    (block-function-body))
  (function exprMissingType () (
    (bad-type))
    (expr-function-body
      (literal 1)))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1)))
  (bad-top-level function)
  (bad-top-level function))
