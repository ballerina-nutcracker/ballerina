function required(int _) {} // @error
function rest(int... _) {} // @error
function init(int '_) {} // @error
function defaulted(int _, int y = 1) returns int => y; // @error
-- ast --
(package
  (function init (
    (variable (bad-identifier) (type
      (value-type int)))) (
    (value-type null))
    (block-function-body))
  (function required (
    (variable (bad-identifier) (type
      (value-type int)))) (
    (value-type null))
    (block-function-body))
  (function rest () (
    (value-type null))
    (block-function-body))
  (function defaulted (
    (variable (bad-identifier) (type
      (value-type int)))
    (variable y (type
      (value-type int)) (expr
      (literal 1)))) (
    (value-type int))
    (expr-function-body
      (simple-var-ref y))))
