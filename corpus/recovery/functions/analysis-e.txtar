                (value-type int))
                (expr-function-body
                  (simple-var-ref missingBody)))))))
        (var-def
          (variable signatureError (expr
            (lambda [callable=isolated function(int) returns int] [function=never] [name=never] [expression-body=unresolved]
              (function $anonFunc$_1 (
