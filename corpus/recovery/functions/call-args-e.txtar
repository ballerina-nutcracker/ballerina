function callee(int a, int b = 2) returns int => a + b;
function missingComma() returns int => callee(1 2); // @error
function namedMissingValue() returns int => callee(1, b = ); // @error
function positionalAfterNamed() returns int => callee(a = 1, 2); // @error
function valid() returns int => callee(1, b = 3);
-- ast --
(package
  (function callee (
    (variable a (type
      (value-type int)))
    (variable b (type
      (value-type int)) (expr
      (literal 2)))) (
    (value-type int))
    (expr-function-body
      (binary-expr +
        (simple-var-ref a)
        (simple-var-ref b))))
  (function missingComma () (
    (value-type int))
    (expr-function-body
      (bad-expr-or-action function-call (tokens ("(" 18:46 18:47) (")" 18:50 18:51)))))
  (function namedMissingValue () (
    (value-type int))
    (expr-function-body
      (invocation callee (
        (literal 1)
        (named-arg b
          (simple-var-ref (bad-identifier)))))))
  (function positionalAfterNamed () (
    (value-type int))
    (expr-function-body
      (invocation callee (
        (named-arg a
          (bad-expr-or-action simple-literal))))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (invocation callee (
        (literal 1)
        (named-arg b
          (literal 3)))))))
