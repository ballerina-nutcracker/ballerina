function unknownOrdinary(Missing value) returns int => 1; // @error
function unknownRest(MissingRest... values) returns int => 2; // @error
function unknownReturn(int value) returns MissingReturn => value; // @error
function independent(int value, string... labels) returns int => value + labels.length();
class Signatures {
    function unknown(MissingMethod value) returns int => 1; // @error
    function surviving(int value) returns int => value;
    function anotherUnknown(MissingOther value) returns int => 2; // @error
}
function bodyOnly(int value) returns int => value + ; // @error
function callBodyOnly(int value) returns int => bodyOnly(value);
-- ast --
(package
  (import-package ballerina lang array (as lang.array))
  (class-definition Signatures
    (function anotherUnknown (
      (variable value (type
        (user-defined-type MissingOther)))) (
      (value-type int))
      (expr-function-body
        (literal 2)))
    (function surviving (
      (variable value (type
        (value-type int)))) (
      (value-type int))
      (expr-function-body
        (simple-var-ref value)))
    (function unknown (
      (variable value (type
        (user-defined-type MissingMethod)))) (
      (value-type int))
      (expr-function-body
        (literal 1))))
  (function unknownOrdinary (
    (variable value (type
      (user-defined-type Missing)))) (
    (value-type int))
    (expr-function-body
      (literal 1)))
  (function unknownRest () (
    (value-type int))
    (expr-function-body
      (literal 2)))
  (function unknownReturn (
    (variable value (type
      (value-type int)))) (
    (user-defined-type MissingReturn))
    (expr-function-body
      (simple-var-ref value)))
  (function independent (
    (variable value (type
      (value-type int)))) (
    (value-type int))
    (expr-function-body
      (binary-expr +
        (simple-var-ref value)
        (invocation lang.array length (
          (simple-var-ref labels))))))
  (function bodyOnly (
    (variable value (type
      (value-type int)))) (
    (value-type int))
    (expr-function-body
      (bad-expr-or-action)))
  (function callBodyOnly (
    (variable value (type
      (value-type int)))) (
    (value-type int))
    (expr-function-body
      (invocation bodyOnly (
        (simple-var-ref value))))))
