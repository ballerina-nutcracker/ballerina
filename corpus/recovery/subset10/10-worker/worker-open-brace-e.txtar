// A missing brace of a worker body or of a fork is reported, and the worker
// is still analysed.
function forkWorkerOpenBrace() {
    fork {
        worker w
            int x = 1; // @error missing open brace
        }
    }
}

function bodyWorkerOpenBrace() {
    worker w
        int x = 1; // @error missing open brace
    }
}

function forkOpenBrace() {
    fork
        worker w { // @error missing open brace of the fork
            int x = 1; // @error unused variable
        }
    }
}
-- ast --
(package
  (function forkWorkerOpenBrace () (
    (value-type null))
    (block-function-body
      (fork
        (named-worker w (
          (value-type null))
          (block-function-body
            (var-def
              (variable x (type
                (value-type int)) (expr
                (literal 1)))))))))
  (function bodyWorkerOpenBrace () (
    (value-type null))
    (block-function-body
      (named-worker w (
        (value-type null))
        (block-function-body
          (var-def
            (variable x (type
              (value-type int)) (expr
              (literal 1))))))))
  (function forkOpenBrace () (
    (value-type null))
    (block-function-body
      (fork
        (named-worker w (
          (value-type null))
          (block-function-body
            (var-def
              (variable x (type
                (value-type int)) (expr
                (literal 1))))))))))
