// A stray statement in a fork is reported from the token it is attached to:
// the fork's `{` when it precedes the workers, else the preceding worker's `}`.
function strayBeforeWorkers() {
    fork { // @error
        return;
        worker w {
        }
    }
}

function strayAfterWorkers() {
    fork {
        worker w {
        } // @error
        return;
    }
}
-- ast --
(package
  (function strayBeforeWorkers () (
    (value-type null))
    (block-function-body
      (bad-stmt fork (tokens ("fork" 20:5 20:9) ("{" 20:10 20:11) ("worker" 22:9 22:15) ("{" 22:18 22:19) ("}" 23:9 23:10) ("}" 24:5 24:6)))))
  (function strayAfterWorkers () (
    (value-type null))
    (block-function-body
      (bad-stmt fork (tokens ("fork" 28:5 28:9) ("{" 28:10 28:11) ("worker" 29:9 29:15) ("{" 29:18 29:19) ("}" 30:9 30:10) ("}" 32:5 32:6))))))
