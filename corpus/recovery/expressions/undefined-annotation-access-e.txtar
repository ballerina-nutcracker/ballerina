function probe() {
    typedesc<int> t = int;
    _ = t.@missing; // @error undefined annotation must not panic
}
-- ast --
(package
  (function probe () (
    (value-type null))
    (block-function-body
      (var-def
        (variable t (type
          (constrained-type
            (value-type typedesc)
            (value-type int))) (expr
          (typedesc-expr
            (value-type int)))))
      (assignment
        (wildcard-binding-pattern)
        (annot-access-expr missing
          (simple-var-ref t))))))
