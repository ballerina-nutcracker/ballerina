function operands() {
    int unary = -; // @error
    int binary = 1 +; // @error
    int nested = (1 + (2 *)); // @error
    int later = 3; // @error unused surviving sibling
}
function valid() returns int => 4;
-- ast --
(package
  (function operands () (
    (value-type null))
    (block-function-body
      (var-def
        (variable unary (type
          (value-type int)) (expr
          (bad-expr-or-action))))
      (var-def
        (variable binary (type
          (value-type int)) (expr
          (bad-expr-or-action))))
      (var-def
        (variable nested (type
          (value-type int)) (expr
          (group-expr
            (binary-expr +
              (literal 1)
              (group-expr
                (bad-expr-or-action)))))))
      (var-def
        (variable later (type
          (value-type int)) (expr
          (literal 3))))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 4))))
