function f(int a, int b) returns int[] => [];

function condition() {
    foreach int i in f(1 2) { // @error
        int a = 1;
    }
    int after = 1;
}

function body(int x, int[] xs) {
    foreach int i in xs {
        int a = 1 int b = 2; // @error
        int c = 3;
    }
    int after = 1;
}

function missingOpenBrace(int x, int[] xs) {
    foreach int i in xs int a = 1; } // @error
    int after = 1;
}

function missingCloseBrace(int x, int[] xs) {
    foreach int i in xs { int a = 1;
    int after = 1;
}
function valid() {} // @error missing close brace of missingCloseBrace
