function f(int a, int b) returns boolean => true;

function condition() {
    while f(1 2) { // @error
        int a = 1;
    }
    int after = 1;
}

function body(int x) {
    while x > 0 {
        int a = 1 int b = 2; // @error
        int c = 3;
    }
    int after = 1;
}

function missingOpenBrace(int x) {
    while x > 0 int a = 1; } // @error
    int after = 1;
}

function missingCloseBrace(int x) {
    while x > 0 { int a = 1;
    int after = 1;
}
function valid() {} // @error missing close brace of missingCloseBrace
