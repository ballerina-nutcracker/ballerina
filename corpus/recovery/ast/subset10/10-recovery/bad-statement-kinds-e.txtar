function statements() {
    int x = 0;
    x += 1
    break // @error
    continue // @error
    panic error("broken") // @error
    return // @error
} // @error
function unsupported() {
    fork { worker w {} } // @error
    rollback; // @error
    retry {} // @error
    do {} on fail var e {} // @error
    lock {} on fail var e {} // @error
    foo()
    xmlns "urn:test" as ; // @error
}
