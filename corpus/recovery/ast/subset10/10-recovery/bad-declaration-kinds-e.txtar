type T int
const int X = 1 // @error
int global = 1 // @error
listener Foo listener1 = new // @error
annotation string A on type // @error
int after = 0; // @error
-- ast --
(compilation-unit (position 1:1 1:1)
(package-id $anon . 0.0.0)
  (bad-top-level type-definition (position 1:1 18:1) (tokens ("type" 17:1 17:5) ("int" 17:8 17:11)))
  (bad-top-level constant (position 18:1 19:1) (tokens ("const" 18:1 18:6) ("int" 18:7 18:10) ("=" 18:13 18:14)))
  (bad-top-level variable (position 19:1 20:1) (tokens ("int" 19:1 19:4) ("=" 19:12 19:13)))
  (bad-top-level listener (position 20:1 21:1) (tokens ("listener" 20:1 20:9) ("=" 20:24 20:25) ("new" 20:26 20:29)))
  (bad-top-level annotation (position 21:1 22:1) (tokens ("annotation" 21:1 21:11) ("string" 21:12 21:18) ("on" 21:21 21:23) ("type" 21:24 21:28)))
  (variable (position 22:1 23:1) after (type
    (value-type (position 22:1 22:5) int)) (expr
    (literal (position 22:13 22:14) 0))))
