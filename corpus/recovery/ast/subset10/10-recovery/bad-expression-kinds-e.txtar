function expressions() {
    any a = (1 + 2; // @error
    any b = {key: 1 other: 2}; // @error
    any c = [1 2]; // @error
    any d = data[0; // @error
    any e = <int value; // @error
    any f = new(1; // @error
    any i = error("bad"; // @error
    any j = base16 `gg`; // @error
    any k = transactional; // @error
    any raw = `hello ${value}`; // @error
    any l = table [{key: 1}]; // @error
    any query = table from var x in [1] select x; // @error
    any prompt = natural {say hello}; // @error
    any conditional = flag ? first second; // @error
    any filter = data.<item; // @error
    any step = data/<item>.foo(1; // @error
    any n = (x y) => x; // @error
}
function defaults(typedesc<any> t = <,>) {} // @error
