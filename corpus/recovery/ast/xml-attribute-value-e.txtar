function interpolatedValue() {
    xml v = xml `<a k=${"v"}/>`; // @error
}

function missingValue() {
    xml v = xml `<a k/>`; // @error
}

function emptyValue() {
    xml v = xml `<a k=/>`; // @error
}

function colonValue() {
    xml v = xml `<a k=:/>`; // @error
}

function interpolatedValueBeforeQualifiedName() {
    xml v = xml `<a k=${"v"}:x=""/>`; // @error
}

function consecutiveInterpolations() {
    xml v = xml `<a k=${"v"} ${"w"}/>`; // @error
}

function quotedValues() {
    xml v = xml `<a k="x${"v"}y" b='z'/>`;
}

function missingValueBeforeSpacedSlash() {
    xml v = xml `<a k/ >`; // @error
}
