} // @error missing semicolon after value

function args() returns int {
    return call(1 2); // @error
}

function parens() returns int {
    int a = (1 + 2; // @error
    return a;
}

function assignments() {
    int a 1; // @error
    a = 2
} // @error missing semicolon after a = 2
