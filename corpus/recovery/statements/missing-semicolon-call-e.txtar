          (invocation f (
            (literal 1))))))
      (var-def
        (variable s (type
          (value-type string)) (expr
          (invocation g (
            (simple-var-ref x))))))
      (var-def
        (variable y (type
          (value-type int)) (expr
          (binary-expr +
            (simple-var-ref x)
            (invocation f (
              (literal 2)))))))
      (var-def
        (variable z (type
          (value-type int)) (expr
          (binary-expr +
            (invocation bar expr:
              (simple-var-ref obj) ())
            (simple-var-ref y)))))
      (return
        (binary-expr +
          (simple-var-ref s)
          (invocation g (
            (simple-var-ref z))))))))
