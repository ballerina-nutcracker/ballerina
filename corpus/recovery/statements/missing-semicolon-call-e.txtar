function foo() {}

function f(int a) returns int => a;

function g(int a) returns string => a.toString();

class Counter {
    int count = 0;

    function bar() returns int => self.count;

    function reset() {
        self.count = 0;
    }
}

// Each missing semicolon is reported at the start of the following line.
function calls(Counter obj) returns string {
    foo()
    obj.reset() // @error
    int x = f(1) // @error
    string s = g(x) // @error
    int y = x + f(2) // @error
    int z = obj.bar() + y // @error
    return s + g(z); // @error
}
-- ast --
