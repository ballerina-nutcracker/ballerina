function f(int a) returns int => a;

// The mismatch is reported only if the call missing its semicolon is typed int.
function calls() returns string {
    string s = f(1) // @error incompatible types
    return s; // @error missing semicolon of the previous line
}
-- ast --
(package
  (function f (
    (variable a (type
      (value-type int)))) (
    (value-type int))
    (expr-function-body
      (simple-var-ref a)))
  (function calls () (
    (value-type string))
    (block-function-body
      (var-def
        (variable s (type
          (value-type string)) (expr
          (invocation f (
            (literal 1))))))
      (return
        (simple-var-ref s)))))
-- stderr --
error[SEMANTIC_ERROR]: incompatible type: expected string, got int
  --> missing-semicolon-call-types-e.bal:21:16
   |
21 |     string s = f(1) // @error incompatible types
   |                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
22 |     return s; // @error missing semicolon of the previous line
   |

error[SYNTAX_ERROR]: missing semicolon token
  --> missing-semicolon-call-types-e.bal:22:1
   |
22 |     return s; // @error missing semicolon of the previous line
   |
-- diagnostic-counts --
1 missing semicolon token
1 incompatible type: expected string, got int
