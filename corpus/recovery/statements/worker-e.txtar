function missingName() {
    worker { // @error missing worker name
    }
}

function missingReturnType() {
    worker w returns { // @error missing return type
    }
}

function malformedBodyStatement() {
    worker w {
        int x = ; // @error missing initializer
    }
    int later = "wrong"; // @error independent semantic analysis
}
