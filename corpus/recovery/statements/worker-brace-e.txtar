// Tokens the parser drops next to a worker body's braces are reported like
// those next to any other block's braces.
function strayTokenBeforeCloseBrace() {
    worker w {
        int _ = 1;
        ) // @error invalid token
    }
    wait w;
}

function strayTokenBeforeOpenBrace() {
    worker w returns int ) { // @error invalid token
        return 1;
    }
    int _ = wait w;
}
-- ast --
(package
  (bad-top-level function (tokens ("function" 18:1 18:9) ("(" 18:36 18:37) (")" 18:37 18:38) ("{" 18:39 18:40) ("worker" 19:5 19:11) ("{" 19:14 19:15) ("int" 20:9 20:12) ("_" 20:13 20:14) ("=" 20:15 20:16) (";" 20:18 20:19) ("}" 22:5 22:6) ("wait" 23:5 23:9) (";" 23:11 23:12) ("}" 24:1 24:2)))
  (bad-top-level function (tokens ("function" 26:1 26:9) ("(" 26:35 26:36) (")" 26:36 26:37) ("{" 26:38 26:39) ("worker" 27:5 27:11) ("returns" 27:14 27:21) ("int" 27:22 27:25) ("{" 27:28 27:29) ("return" 28:9 28:15) (";" 28:17 28:18) ("}" 29:5 29:6) ("int" 30:5 30:8) ("_" 30:9 30:10) ("=" 30:11 30:12) ("wait" 30:13 30:17) (";" 30:19 30:20) ("}" 31:1 31:2))))
