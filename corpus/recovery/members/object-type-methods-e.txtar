type FunctionTypeFieldMissingName object {
    function (int a) returns int; // @error
    function valid() returns int;
};
type MissingComma object {
    function m(int a int b); // @error
    function valid() returns int;
};
type MissingParamName object {
    function m(int ); // @error
    function valid() returns int;
};
type MissingFirstType object {
    function m(a, int b); // @error
    function valid() returns int;
};
type MissingSecondType object {
    function m(int a, b); // @error
    function valid() returns int;
};
type LeadingComma object {
    function m(, int a); // @error
    function valid() returns int;
};
type TrailingComma object {
    function m(int a, ); // @error
    function valid() returns int;
};
type MissingDefault object {
    function m(int x = ); // @error
    function valid() returns int;
};
type Mixed object {
    function m(int a, string b = , int c = 1, d, int... ); // @error
    function valid() returns int;
};
type MissingReturnType object {
    function m() returns; // @error
    function valid() returns int;
};
type MissingReturnsKeyword object {
    function m() int; // @error
    function valid() returns int;
};
type MissingSemicolon object {
    function m() returns int
    function valid() returns int; // @error missing semicolon is reported at the next method
};
function valid() returns int => 1;
-- ast --
(package
  (type-definition FunctionTypeFieldMissingName
    (object-type
      (method-decl valid () (
        (value-type int)))
      (bad-top-level field (tokens ("function" 18:5 18:13) ("(" 18:14 18:15) ("int" 18:15 18:18) (")" 18:20 18:21) ("returns" 18:22 18:29) ("int" 18:30 18:33) (";" 18:33 18:34)))))
  (type-definition MissingComma
    (object-type
      (method-decl valid () (
        (value-type int)))
      (bad-top-level function (tokens ("function" 22:5 22:13) ("(" 22:15 22:16) ("int" 22:16 22:19) ("int" 22:22 22:25) (")" 22:27 22:28) (";" 22:28 22:29)))))
  (type-definition MissingParamName
    (object-type
      (method-decl m (
        (param (bad-identifier)
          (value-type int))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition MissingFirstType
    (object-type
      (method-decl m (
        (param (bad-identifier)
          (user-defined-type a))
        (param b
          (value-type int))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition MissingSecondType
    (object-type
      (method-decl m (
        (param a
          (value-type int))
        (param (bad-identifier)
          (user-defined-type b))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition LeadingComma
    (object-type
      (method-decl m (
        (param a
          (bad-type builtin (tokens ("int" 38:18 38:21))))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition TrailingComma
    (object-type
      (method-decl m (
        (param a
          (value-type int))
        (param (bad-identifier)
          (bad-type simple-reference))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition MissingDefault
    (object-type
      (method-decl m (
        (param x
          (value-type int))) (
        (value-type null)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition Mixed
    (object-type
      (method-decl valid () (
        (value-type int)))
      (bad-top-level function (tokens ("function" 50:5 50:13) ("(" 50:15 50:16) ("int" 50:16 50:19) ("," 50:21 50:22) ("string" 50:23 50:29) ("=" 50:32 50:33) ("," 50:34 50:35) ("int" 50:36 50:39) ("=" 50:42 50:43) ("," 50:45 50:46) (")" 50:57 50:58) (";" 50:58 50:59)))))
  (type-definition MissingReturnType
    (object-type
      (method-decl m () (
        (bad-type simple-reference)))
      (method-decl valid () (
        (value-type int)))))
  (type-definition MissingReturnsKeyword
    (object-type
      (method-decl valid () (
        (value-type int)))
      (bad-top-level function (tokens ("function" 58:5 58:13) ("(" 58:15 58:16) (")" 58:16 58:17) (";" 58:21 58:22)))))
  (type-definition MissingSemicolon
    (object-type
      (method-decl valid () (
        (value-type int)))
      (bad-top-level function (tokens ("function" 62:5 62:13) ("(" 62:15 62:16) (")" 62:16 62:17) ("returns" 62:18 62:25) ("int" 62:26 62:29)))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1))))
