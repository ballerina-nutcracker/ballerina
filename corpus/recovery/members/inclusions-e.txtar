    (value-type int))
    (expr-function-body
      (invocation read expr:
        (simple-var-ref value) ())))
  (function readObject (
    (variable value (type
      (user-defined-type MixedObject)))) (
    (value-type int))
    (expr-function-body
      (field-based-access inheritedValue
        (simple-var-ref value))))
  (function readRecord (
    (variable value (type
      (user-defined-type MixedRecord)))) (
    (value-type int))
    (expr-function-body
      (field-based-access inheritedValue
        (simple-var-ref value))))
  (function readConsumer (
    (variable value (type
      (user-defined-type ObjectConsumer)))) (
