class C {
    int total;
    function init(int a, int b = 2) { self.total = a + b; }
    function m(int a, int b = 2) returns int => a + b;
}
function missingComma(C obj) returns int => obj.m(1 2); // @error
function namedMissingValue(C obj) returns int => obj.m(1, b = ); // @error
function positionalAfterNamed(C obj) returns int => obj.m(a = 1, 2); // @error
function newMissingComma() returns C => new C(1 2); // @error
function newNamedMissingValue() returns C => new C(1, b = ); // @error
function newPositionalAfterNamed() returns C => new C(a = 1, 2); // @error
function valid(C obj) returns C => new C(obj.m(1, b = 3));
-- ast --
(package
  (class-definition C
    (variable total (type
      (value-type int)))
    (function init (
      (variable a (type
        (value-type int)))
      (variable b (type
        (value-type int)) (expr
        (literal 2)))) (
      (value-type null))
      (block-function-body
        (assignment
          (field-based-access total
            (simple-var-ref self))
          (binary-expr +
            (simple-var-ref a)
            (simple-var-ref b)))))
    (function m (
      (variable a (type
        (value-type int)))
      (variable b (type
        (value-type int)) (expr
        (literal 2)))) (
      (value-type int))
      (expr-function-body
        (binary-expr +
          (simple-var-ref a)
          (simple-var-ref b)))))
  (function missingComma (
    (variable obj (type
      (user-defined-type C)))) (
    (value-type int))
    (expr-function-body
      (bad-expr-or-action)))
  (function namedMissingValue (
    (variable obj (type
      (user-defined-type C)))) (
    (value-type int))
    (expr-function-body
      (invocation m expr:
        (simple-var-ref obj) (
        (literal 1)
        (named-arg b
          (simple-var-ref (bad-identifier)))))))
  (function positionalAfterNamed (
    (variable obj (type
      (user-defined-type C)))) (
    (value-type int))
    (expr-function-body
      (invocation m expr:
        (simple-var-ref obj) (
        (named-arg a
          (bad-expr-or-action))))))
  (function newMissingComma () (
    (user-defined-type C))
    (expr-function-body
      (bad-expr-or-action)))
  (function newNamedMissingValue () (
    (user-defined-type C))
    (expr-function-body
      (new
        (user-defined-type C) (
        (literal 1)
        (named-arg b
          (simple-var-ref (bad-identifier)))))))
  (function newPositionalAfterNamed () (
    (user-defined-type C))
    (expr-function-body
      (new
        (user-defined-type C) (
        (named-arg a
          (bad-expr-or-action))))))
  (function valid (
    (variable obj (type
      (user-defined-type C)))) (
    (user-defined-type C))
    (expr-function-body
      (new
        (user-defined-type C) (
        (invocation m expr:
          (simple-var-ref obj) (
          (literal 1)
          (named-arg b
            (literal 3)))))))))
