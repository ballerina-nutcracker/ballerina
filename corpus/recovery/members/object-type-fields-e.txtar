type MissingType object {
    x; // @error
    int valid;
};
type MissingName object {
    int; // @error
    int valid;
};
type MissingSemicolon object {
    int missingSemicolon
    int valid; // @error missing semicolon is reported at the next field
};
type InclusionMissingSemicolon object {
    *MissingObjectBase
    int valid; // @error missing semicolon is reported at the next field
};
type MissingCloseBrace object {
    int a;
; // @error
function valid() returns int => 1;
-- ast --
(package
  (type-definition MissingType
    (object-type
      (field valid
        (value-type int))
      (bad-top-level field (tokens (";" 18:6 18:7)))))
  (type-definition MissingName
    (object-type
      (field valid
        (value-type int))
      (bad-top-level field (tokens ("int" 22:5 22:8) (";" 22:8 22:9)))))
  (type-definition MissingSemicolon
    (object-type
      (field valid
        (value-type int))
      (bad-top-level field (tokens ("int" 26:5 26:8)))))
  (type-definition InclusionMissingSemicolon
    (object-type
      (field valid
        (value-type int))
      (bad-top-level type-inclusion (tokens ("*" 30:5 30:6)))))
  (type-definition MissingCloseBrace
    (bad-type object (tokens ("object" 33:24 33:30) ("{" 33:31 33:32) ("int" 34:5 34:8) (";" 34:10 34:11))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1))))
