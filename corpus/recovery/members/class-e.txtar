class C {
    int _; // @error
    int goodField;
    function _(int x) {} // @error
    function init(int _) {} // @error
    *mod:_; // @error
    *; // @error
    function valid() { int x = ; int later = 2; } // @error
}
function _() {} // @error
function valid() { C surviving; } // @error unused surviving sibling
class InclusionFailure {
    *Missing; // @error
    int good;
    function method() returns int => self.good;
}
type RecordWithBadInclusion record {
    *mod:_; // @error
    int good;
};
type RecordWithUnknownInclusion record {
    *Missing; // @error
    int good = 1;
};
-- ast --
(package
  (type-definition RecordWithBadInclusion
    (record-type
      (field good
        (value-type int))))
  (type-definition RecordWithUnknownInclusion
    (record-type
      (field good
        (value-type int)
        (literal 1))))
  (class-definition C
    (variable (bad-identifier) (type
      (value-type int)))
    (variable goodField (type
      (value-type int)))
    (function init (
      (variable (bad-identifier) (type
        (value-type int)))) (
      (value-type null))
      (block-function-body))
    (function (bad-identifier) (
      (variable x (type
        (value-type int)))) (
      (value-type null))
      (block-function-body))
    (function valid () (
      (value-type null))
      (block-function-body
        (var-def
          (variable x (type
            (value-type int)) (expr
            (simple-var-ref (bad-identifier)))))
        (var-def
          (variable later (type
            (value-type int)) (expr
            (literal 2))))))
    (bad-top-level type-inclusion (tokens ("*" 22:5 22:6) (":" 22:9 22:10) (";" 22:11 22:12)))
    (bad-top-level type-inclusion (tokens ("*" 23:5 23:6) (";" 23:6 23:7))))
  (class-definition InclusionFailure
    (variable good (type
      (value-type int)))
    (function method () (
      (value-type int))
      (expr-function-body
        (field-based-access good
          (simple-var-ref self)))))
  (function (bad-identifier) () (
    (value-type null))
    (block-function-body))
  (function valid () (
    (value-type null))
    (block-function-body
      (var-def
        (variable surviving (type
          (user-defined-type C)))))))
