var obj = object {
    x; // @error
    y = 1; // @error
    int; // @error
    int = 1; // @error
    int missingExpr = ; // @error
    int missingSemicolon = 1
    int next = 2; // @error missing semicolon is reported at the next field
    int valid = 3;
};
function valid() returns int => 1;
-- ast --
(package
  (variable obj (expr
    (bad-expr-or-action object-constructor (tokens ("object" 17:11 17:17) ("{" 17:18 17:19) ("=" 19:7 19:8) (";" 19:10 19:11) ("int" 20:5 20:8) (";" 20:8 20:9) ("int" 21:5 21:8) ("=" 21:9 21:10) (";" 21:12 21:13) ("int" 22:5 22:8) ("=" 22:21 22:22) (";" 22:23 22:24) ("int" 23:5 23:8) ("=" 23:26 23:27) ("int" 24:5 24:8) ("=" 24:14 24:15) (";" 24:17 24:18) ("int" 25:5 25:8) ("=" 25:15 25:16) (";" 25:18 25:19) ("}" 26:1 26:2)))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1))))
