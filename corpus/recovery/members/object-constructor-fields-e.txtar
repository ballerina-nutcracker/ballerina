var obj = object {
    x; // @error
    y = 1; // @error
    int; // @error
    int = 1; // @error
    int missingExpr = ; // @error
    int missingSemicolon = 1
    int next = 2; // @error missing semicolon is reported at the next field
    int valid = 3;
};
function valid() returns int => 1;
-- ast --
(package
  (variable obj (expr
    (bad-expr-or-action)))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1))))
