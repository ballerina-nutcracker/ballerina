class C {
    x; // @error
    y = 1; // @error
    int; // @error
    int = 1; // @error
    int missingExpr = ; // @error
    int missingSemicolon = 1
    int next = 2; // @error missing semicolon is reported at the next field
    int valid = 3;
}
function valid() returns int => 1;
-- ast --
(package
  (class-definition C
    (variable (bad-identifier) (type
      (user-defined-type x)) (expr
      (literal 1)))
    (variable (bad-identifier) (type
      (value-type int)))
    (variable (bad-identifier) (type
      (value-type int)) (expr
      (literal 1)))
    (variable missingExpr (type
      (value-type int)) (expr
      (simple-var-ref (bad-identifier))))
    (variable next (type
      (value-type int)) (expr
      (literal 2)))
    (variable valid (type
      (value-type int)) (expr
      (literal 3)))
    (bad-top-level field (tokens ("int" 23:5 23:8) ("=" 23:26 23:27))))
  (function valid () (
    (value-type int))
    (expr-function-body
      (literal 1))))
