    function missingDefault(int x = ) {} // @error
    function mixed(int a, string b = , int c = 1, d, int... ) {} // @error
    function blockMissingType() returns {} // @error
    function exprMissingType() returns => 1; // @error
    function blockMissingKeyword() int {} // @error
    function missingBody() returns int
    function next() returns int => 1; // @error missing body of missingBody is reported at the next method
    function valid(int a, int b = 1, int... rest) returns int => a + b + rest.length();
}
function valid() returns int => 1;
