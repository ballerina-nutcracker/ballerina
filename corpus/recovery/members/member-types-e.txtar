          (builtin-ref-type xml)
          (value-type int))))) (
      (value-type null))
      (block-function-body
        (assignment
          (wildcard-binding-pattern)
          (simple-var-ref value))))
    (function method () (
      (constrained-type
        (builtin-ref-type xml)
        (value-type int)))
      (block-function-body))
    (resource-function get name:first
      (constrained-type
