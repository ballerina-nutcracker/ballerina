import ballerina/io;

type Rec record {| int a; string b; |};

function callee0(int p0, string p1, boolean p2, float p3, Rec p4, int? p5) returns int {
    _ = p1;
    _ = p2;
    _ = p3;
    _ = p4;
    _ = p5;
    return p0 + 0;
}
function callee1(int p0, string p1, boolean p2, float p3, Rec p4, int? p5) returns int {
    _ = p1;
    _ = p2;
    _ = p3;
    _ = p4;
    _ = p5;
    return p0 + 1;
}
function callee2(int p0, string p1, boolean p2, float p3, Rec p4, int? p5) returns int {
    _ = p1;
    _ = p2;
    _ = p3;
    _ = p4;
    _ = p5;
    return p0 + 2;
}
function callee3(int p0, string p1, boolean p2, float p3, Rec p4, int? p5) returns int {
    _ = p1;
    _ = p2;
    _ = p3;
    _ = p4;
    _ = p5;
    return p0 + 3;
}
