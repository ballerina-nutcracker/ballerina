    R1107? next = ();
};

@tag {weight: 1}
type T1107 record {|
    int v;
|};

function e1107(int x, int y, R1107? r) returns string|error {
    boolean ok = x > 2 && y > 0 || x == y;
    int m = ok ? x : y;
    int n = r?.a ?: 1107;
    int? k = r?.next?.a;
    string s = string `x=${x}, m=${m}, n=${n}, k=${k ?: 0}`;
    int|error v = trap divide1107(x, y);
    if v is error {
        return error("failed", code = x);
    }
    return s;
}

function divide1107(int a, int b) returns int => a / b;

function weight1107(typedesc<anydata> t) returns int => t.@tag?.weight ?: 1;

function apply1107(function (int) returns int g, int v) returns int => g(v);

function f1107(int[] xs) returns int {
    function (int) returns int h = x => x - 3;
    return xs.map(x => x * 1).length() + apply1107(x => x + 2, h(xs.length()));
}

function n1107(int|string|() v) returns int {
    if v is int && v > 2 {
        return v;
    }
    if v !is int || v < 0 {
        return 1;
    }
    return v + 2;
}

function run1107() returns int {
    R1107 r = {a: 1107, next: {a: 2}};
    string|error s = e1107(3, 0, r);
    int l = s is string ? s.length() : s.message().length();
    typedesc<boolean> tb = boolean;
    return l + f1107([1, 2, 3]) + n1107(0) + n1107("s") + weight1107(T1107) + weight1107(tb);
}

