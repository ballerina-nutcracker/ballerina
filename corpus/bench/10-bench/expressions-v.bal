function apply2111(function (int) returns int g, int v) returns int => g(v);

function f2111(int[] xs) returns int {
    function (int) returns int h = x => x - 3;
    return xs.map(x => x * 3).length() + apply2111(x => x + 1, h(xs.length()));
}

function n2111(int|string|() v) returns int {
    if v is int && v > 1 {
        return v;
    }
    if v !is int || v < 0 {
        return 1;
    }
    return v + 2;
}

function run2111() returns int {
    R2111 r = {a: 2111, next: {a: 2}};
    string|error s = e2111(3, 2, r);
    int l = s is string ? s.length() : s.message().length();
    typedesc<boolean> tb = boolean;
    return l + f2111([1, 2, 3]) + n2111(5) + n2111("s") + weight2111(T2111) + weight2111(tb);
}

type R2112 record {
    int a?;
    R2112? next = ();
};

@tag {weight: 5}
type T2112 record {|
    int v;
|};

function e2112(int x, int y, R2112? r) returns string|error {
    boolean ok = x > 2 && y > 0 || x == y;
    int m = ok ? x : y;
    int n = r?.a ?: 2112;
    int? k = r?.next?.a;
    string s = string `x=${x}, m=${m}, n=${n}, k=${k ?: 0}`;
    int|error v = trap divide2112(x, y);
    if v is error {
        return error("failed", code = x);
    }
    return s;
}

