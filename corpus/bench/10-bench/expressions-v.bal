import ballerina/io;

type Ann record {| int weight; |};

annotation Ann tag on type;

type R0 record {
    int a?;
    R0? next = ();
};

@tag {weight: 0}
type T0 record {|
    int v;
|};

function e0(int x, int y, R0? r) returns string|error {
    boolean ok = x > 0 && y > 0 || x == y;
    int m = ok ? x : y;
    int n = r?.a ?: 0;
    int? k = r?.next?.a;
    string s = string `x=${x}, m=${m}, n=${n}, k=${k ?: 0}`;
    int|error v = trap divide0(x, y);
    if v is error {
        return error("failed", code = x);
    }
    return s;
}

function divide0(int a, int b) returns int => a / b;

function weight0(typedesc<anydata> t) returns int => t.@tag?.weight ?: 1;

function apply0(function (int) returns int g, int v) returns int => g(v);

function f0(int[] xs) returns int {
    function (int) returns int h = x => x - 0;
    return xs.map(x => x * 1).length() + apply0(x => x + 0, h(xs.length()));
}

function n0(int|string|() v) returns int {
    if v is int && v > 0 {
        return v;
    }
    if v !is int || v < 0 {
        return 1;
    }
    return v + 2;
}

function run0() returns int {
    R0 r = {a: 0, next: {a: 2}};
    string|error s = e0(0, 0, r);
    int l = s is string ? s.length() : s.message().length();
    typedesc<int> tb = int;
    return l + f0([1, 2, 3]) + n0(0) + n0("s") + weight0(T0) + weight0(tb);
}

type R1 record {
    int a?;
    R1? next = ();
};

@tag {weight: 1}
type T1 record {|
    int v;
|};

function e1(int x, int y, R1? r) returns string|error {
    boolean ok = x > 1 && y > 0 || x == y;
    int m = ok ? x : y;
    int n = r?.a ?: 1;
    int? k = r?.next?.a;
    string s = string `x=${x}, m=${m}, n=${n}, k=${k ?: 0}`;
    int|error v = trap divide1(x, y);
    if v is error {
        return error("failed", code = x);
    }
    return s;
}

function divide1(int a, int b) returns int => a / b;

function weight1(typedesc<anydata> t) returns int => t.@tag?.weight ?: 1;

function apply1(function (int) returns int g, int v) returns int => g(v);

function f1(int[] xs) returns int {
    function (int) returns int h = x => x - 1;
    return xs.map(x => x * 2).length() + apply1(x => x + 1, h(xs.length()));
}

function n1(int|string|() v) returns int {
    if v is int && v > 1 {
        return v;
    }
    if v !is int || v < 0 {
        return 1;
    }
    return v + 2;
}

function run1() returns int {
    R1 r = {a: 1, next: {a: 2}};
    string|error s = e1(1, 1, r);
    int l = s is string ? s.length() : s.message().length();
    typedesc<string> tb = string;
    return l + f1([1, 2, 3]) + n1(1) + n1("s") + weight1(T1) + weight1(tb);
}

