function apply(function (int) returns int f, int v) returns int => f(v);

type Node record {| int v; Node? n = (); |};

function depth(Node? n) returns int {
    int c = 0;
    Node? cur = n;
    while cur is Node {
        c += cur.v;
        cur = cur.n;
    }
    return c;
}

