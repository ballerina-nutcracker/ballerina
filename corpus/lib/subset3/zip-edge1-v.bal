import ballerina/file;
import ballerina/io;
import ballerina/zip;

// Built by hand: the central directory lists `second.txt` before `first.txt`, which is stored first;
// `old.txt` has an NTFS time before the epoch; eighteen names hold malformed UTF-8; `z64.bin` takes its
// sizes, offset and disk from a Zip64 field; and the archive ends with Zip64 end of central directory
// records.
const string EDGE = "504b03040a0000000000c053cf50b7efdc8301000000010000000900000066697273742e74787431504b03040a0000000000"
    + "c053cf500dbed51a01000000010000000a0000007365636f6e642e74787432504b03040a0000000000c053cf5044930f0f01"
    + "00000001000000070000006f6c642e7478746f504b03040a0000080000c053cf508316dc8c01000000010000000400000065"
    + "31e28278504b03040a0000080000c053cf508316dc8c0100000001000000050000006532f09f9878504b03040a0000080000"
    + "c053cf508316dc8c0100000001000000050000006533c0af7978504b03040a0000080000c053cf508316dc8c010000000100"
    + "0000060000006534eda0807a78504b03040a0000080000c053cf508316dc8c0100000001000000070000006535f49080807a"
    + "78504b03040a0000080000c053cf508316dc8c0100000001000000060000006536e080af7a78504b03040a0000080000c053"
    + "cf508316dc8c010000000100000005000000653780807a78504b03040a0000080000c053cf508316dc8c0100000001000000"
    + "070000006538f09f98807a78504b03040a0000080000c053cf508316dc8c0100000001000000080000006539f8888080807a"
    + "78504b03040a0000080000c053cf508316dc8c010000000100000009000000653130e282e282ac7a78504b03040a00000800"
    + "00c053cf508316dc8c010000000100000006000000653131f09f7a78504b03040a0000080000c053cf508316dc8c01000000"
    + "0100000004000000653132c378504b03040a0000080000c053cf508316dc8c010000000100000005000000653133fffe7850"
    + "4b03040a0000080000c053cf508316dc8c010000000100000006000000653134c3a9d078504b03040a0000080000c053cf50"
    + "8316dc8c010000000100000007000000653135f080808078504b03040a0000080000c053cf508316dc8c0100000001000000"
    + "07000000653136f09f414178504b03040a0000080000c053cf508316dc8c010000000100000007000000653137f48fbfbf78"
    + "504b03040a0000080000c053cf508316dc8c010000000100000005000000653138e24178504b03040a0000000000c053cf50"
    + "b71d4e340c0000000c000000070000007a36342e62696e7a69703634206669656c6473504b010214030a0000000000c053cf"
    + "500dbed51a01000000010000000a0000000000000000000000a481280000007365636f6e642e747874504b010214030a0000"
    + "000000c053cf50b7efdc830100000001000000090000000000000000000000a4810000000066697273742e747874504b0102"
    + "14030a0000000000c053cf5044930f0f0100000001000000070024000000000000000000a481510000006f6c642e7478740a"
    + "0020000000000001001800fb177a73d6b19d0100000000000000000000000000000000504b010214030a0000080000c053cf"
    + "508316dc8c0100000001000000040000000000000000000000a481770000006531e282504b010214030a0000080000c053cf"
    + "508316dc8c0100000001000000050000000000000000000000a4819a0000006532f09f98504b010214030a0000080000c053"
    + "cf508316dc8c0100000001000000050000000000000000000000a481be0000006533c0af79504b010214030a0000080000c0"
    + "53cf508316dc8c0100000001000000060000000000000000000000a481e20000006534eda0807a504b010214030a00000800"
    + "00c053cf508316dc8c0100000001000000070000000000000000000000a481070100006535f49080807a504b010214030a00"
    + "00080000c053cf508316dc8c0100000001000000060000000000000000000000a4812d0100006536e080af7a504b01021403"
    + "0a0000080000c053cf508316dc8c0100000001000000050000000000000000000000a48152010000653780807a504b010214"
    + "030a0000080000c053cf508316dc8c0100000001000000070000000000000000000000a481760100006538f09f98807a504b"
    + "010214030a0000080000c053cf508316dc8c0100000001000000080000000000000000000000a4819c0100006539f8888080"
    + "807a504b010214030a0000080000c053cf508316dc8c0100000001000000090000000000000000000000a481c30100006531"
    + "30e282e282ac7a504b010214030a0000080000c053cf508316dc8c0100000001000000060000000000000000000000a481eb"
    + "010000653131f09f7a504b010214030a0000080000c053cf508316dc8c0100000001000000040000000000000000000000a4"
    + "8110020000653132c3504b010214030a0000080000c053cf508316dc8c0100000001000000050000000000000000000000a4"
    + "8133020000653133fffe504b010214030a0000080000c053cf508316dc8c0100000001000000060000000000000000000000"
    + "a48157020000653134c3a9d0504b010214030a0000080000c053cf508316dc8c010000000100000007000000000000000000"
    + "0000a4817c020000653135f0808080504b010214030a0000080000c053cf508316dc8c010000000100000007000000000000"
    + "0000000000a481a2020000653136f09f4141504b010214030a0000080000c053cf508316dc8c010000000100000007000000"
    + "0000000000000000a481c8020000653137f48fbfbf504b010214030a0000080000c053cf508316dc8c010000000100000005"
    + "0000000000000000000000a481ee020000653138e241504b010214030a0000000000c053cf50b71d4e34ffffffffffffffff"
    + "070020000000ffff00000000a481ffffffff7a36342e62696e01001c000c000000000000000c000000000000001203000000"
    + "00000000000000504b06062c000000000000002d002d00000000000000000016000000000000001600000000000000c60400"
    + "00000000004303000000000000504b060700000000090800000000000001000000504b050600000000ffffffffffffffffff"
    + "ffffff0000";

// `t1975.txt` carries an extended timestamp and `t2200.txt` an NTFS time, both outside the DOS range.
const string TIMES = "504b0304140000000800c053cf50e5d45d3f05000000030000000900090074313937352e74787455540500014d356909cbcf"
    + "490100504b0304140000000800c053cf508831ebc808000000060000000900240074323230302e7478740a00200000000000"
    + "010018008044d9b52f8f9f02000000000000000000000000000000004b2b2d292d4a0500504b01021403140000000800c053"
    + "cf50e5d45d3f0500000003000000090009000000000000000000a4810000000074313937352e74787455540500014d356909"
    + "504b01021403140000000800c053cf508831ebc80800000006000000090024000000000000000000a4813500000074323230"
    + "302e7478740a00200000000000010018008044d9b52f8f9f0200000000000000000000000000000000504b05060000000002"
    + "0002009b000000880000000000";

function fromHex(string hex) returns byte[]|error {
    byte[] bytes = [];
    int i = 0;
    while i < hex.length() {
        bytes.push(<byte>check int:fromHexString(hex.substring(i, i + 2)));
        i += 2;
    }
    return bytes;
}

public function main() returns error? {
    string dir = check file:createTempDir(prefix = "bal-zip-edge1-");
    string edge = check file:joinPath(dir, "edge.zip");
    check io:fileWriteBytes(edge, check fromHex(EDGE));
    foreach zip:Entry entry in check zip:listEntries(edge) {
        io:println(entry.name.toBytes());
    }
    // @output [102,105,114,115,116,46,116,120,116]
    // @output [115,101,99,111,110,100,46,116,120,116]
    // @output [111,108,100,46,116,120,116]
    // @output [101,49,239,191,189]
    // @output [101,50,239,191,189]
    // @output [101,51,239,191,189,239,191,189,121]
    // @output [101,52,239,191,189,122]
    // @output [101,53,239,191,189,239,191,189,239,191,189,239,191,189,122]
    // @output [101,54,239,191,189,239,191,189,239,191,189,122]
    // @output [101,55,239,191,189,239,191,189,122]
    // @output [101,56,240,159,152,128,122]
    // @output [101,57,239,191,189,239,191,189,239,191,189,239,191,189,239,191,189,122]
    // @output [101,49,48,239,191,189,226,130,172,122]
    // @output [101,49,49,239,191,189,122]
    // @output [101,49,50,239,191,189]
    // @output [101,49,51,239,191,189,239,191,189]
    // @output [101,49,52,195,169,239,191,189]
    // @output [101,49,53,239,191,189,239,191,189,239,191,189,239,191,189]
    // @output [101,49,54,239,191,189,65,65]
    // @output [101,49,55,244,143,191,191]
    // @output [101,49,56,239,191,189,65]
    // @output [122,54,52,46,98,105,110]

    zip:ArchiveReader reader = check new (edge);
    zip:Entry old = check reader.getEntry("old.txt");
    io:println(old.modifiedTime); // @output [0,0]
    zip:Entry z64 = check reader.getEntry("z64.bin");
    io:println(z64.uncompressedSize, " ", z64.compressedSize); // @output 12 12
    io:println(check string:fromBytes(check reader.readEntry("z64.bin"))); // @output zip64 fields
    check reader.close();

    string times = check file:joinPath(dir, "times.zip");
    check io:fileWriteBytes(times, check fromHex(TIMES));
    string out = check file:joinPath(dir, "out");
    check zip:decompress(times, out);
    string rewritten = check file:joinPath(dir, "rewritten.zip");
    zip:ArchiveWriter writer = check new (rewritten);
    check writer.addFile(check file:joinPath(out, "t1975.txt"));
    check writer.addFile(check file:joinPath(out, "t2200.txt"));
    zip:ArchiveReader timesReader = check new (times);
    check writer.copyEntry(timesReader, "t1975.txt");
    check timesReader.close();
    check writer.close();
    foreach zip:Entry entry in check zip:listEntries(rewritten) {
        io:println(entry.name, " ", entry.modifiedTime);
    }
    // @output t1975.txt [157889869,0]
    // @output t2200.txt [7258240845,0]
    // @output t1975.txt [157889869,0]
    check file:remove(dir, file:RECURSIVE);
}
