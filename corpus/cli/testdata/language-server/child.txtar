package main

import (
    "encoding/json"
    "io"
    "os"
    "strconv"
)

func main() {
    cwd, err := os.Getwd()
    if err != nil {
        panic(err)
    }
    _ = json.NewEncoder(os.Stderr).Encode(struct {
        Dir string
        Marker string
        Args []string
    }{cwd, os.Getenv("LS_TEST_MARKER"), os.Args[1:]})
    if _, err := io.Copy(os.Stdout, os.Stdin); err != nil {
        panic(err)
    }
    if os.Getenv("LS_TEST_KILL") == "1" {
        process, err := os.FindProcess(os.Getpid())
        if err != nil {
            panic(err)
        }
        _ = process.Kill()
        select {}
    }
    code, err := strconv.ParseUint(os.Getenv("LS_TEST_EXIT"), 10, 32)
    if err != nil {
        panic(err)
    }
    os.Exit(int(code))
}
