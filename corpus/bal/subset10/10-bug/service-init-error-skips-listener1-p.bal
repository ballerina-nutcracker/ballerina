import ballerina/io;

class L {
    function init() {
        io:println("listener init");
    }

    public function attach(service object {} svc, () attachPoint = ()) returns error? {
        var _ = svc;
        var _ = attachPoint;
    }

    public function detach(service object {} svc) returns error? {
        var _ = svc;
    }

    public function 'start() returns error? {
    }

    public function gracefulStop() returns error? {
    }

    public function immediateStop() returns error? {
    }
}

// The service object is constructed before any listener expression is
// evaluated, so a failing service init means "listener init" is never printed.
service on new L() {
    function init() returns error? {
        return error("service init failed"); // @panic service init failed
    }
}

public function main() {
}
